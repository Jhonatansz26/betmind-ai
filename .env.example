ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# En producción: false — el schema solo cambia por migraciones.
AUTO_CREATE_TABLES=true
DATABASE_URL=postgresql+asyncpg://postgres:tu_password@db.tu_proyecto.supabase.co:5432/postgres
REDIS_URL=redis://localhost:6379/0
API_FOOTBALL_KEY=tu_api_key_de_api_football_aqui
# Limiter distribuido: Free documenta 10/min y 100/día; 8/min deja margen.
API_FOOTBALL_REQUESTS_PER_MINUTE=8
API_FOOTBALL_REQUESTS_PER_DAY=100
FOOTBALL_DATA_KEY=tu_football_data_key_aqui
GROQ_API_KEYS=tu_groq_api_key_aqui
ANTHROPIC_API_KEY=tu_anthropic_api_key_aqui
GEMINI_API_KEY=tu_gemini_api_key_aqui
SECRET_KEY=cambia_esto_por_un_secret_seguro
# Secreto DEDICADO para tokens de reset de contraseña. Al setearlo, se
# invalidan TODOS los tokens de reset pendientes sin tocar los de sesión.
# Recomendado: setearlo en producción tras este despliegue.
#RESET_TOKEN_SECRET=cambia_esto_por_un_secret_distinto
# Backdoor de desarrollo X-Betmind-Dev-Pro: requiere DEBUG=true ADEMÁS de
# esta variable. Apagada por defecto; NUNCA activar en producción.
#ENABLE_DEV_BACKDOOR=true
# Proxies/load balancers autorizados a propagar la IP real del cliente
# (X-Forwarded-For). IPs o rangos CIDR separados por coma. Vacío = nunca
# confiar en el header.
#TRUSTED_PROXIES=10.0.0.1,172.16.0.0/12
ADMIN_API_KEY=tu_admin_api_key_aqui
# Cuota minima aceptable para 1X2_DRAW en el parseo (DNB colado en la columna X).
MIN_DRAW_ODDS_THRESHOLD=2.10

# ---- Wompi (dejar en sandbox para el primer deploy de validacion) ----
WOMPI_BASE_URL=https://sandbox.wompi.co/v1
WOMPI_PUBLIC_KEY=pub_test_...
WOMPI_PRIVATE_KEY=prv_test_...
WOMPI_INTEGRITY_SECRET=...
WOMPI_EVENTS_SECRET=...
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
# ── Email ──────────────────────────────────────────────────────────────────
# Priority: SMTP > Resend > console stub
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=tu_cuenta_gmail@gmail.com
SMTP_PASSWORD=tu_app_password_16_chars
EMAIL_FROM_ADDRESS=tu_cuenta_gmail@gmail.com
RESEND_API_KEY=re_tu_api_key_de_resend_aqui
