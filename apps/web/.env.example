NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WOMPI_BASE_URL=https://sandbox.wompi.co/v1
# Llave pública del widget de Wompi (sandbox: pub_test_*, producción: pub_prod_*).
# NEXT_PUBLIC_WOMPI_PUBLIC_KEY se mantiene como alias de compatibilidad.
NEXT_PUBLIC_WOMPI_PUB_KEY=pub_test_your_public_key_here
# CDN del widget de Wompi (no cambiar salvo entorno controlado).
NEXT_PUBLIC_WOMPI_WIDGET_URL=https://checkout.wompi.co/widget.js
